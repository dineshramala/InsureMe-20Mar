pipeline{
 agent any
  tools{
    maven 'M2_HOME'
       }
 stages{
  stage('git checkout'){
   steps{
    echo 'this is for cloning git repositary'
    git branch: 'main', url: 'https://github.com/dineshramala/InsureMe-20Mar.git'
               }
   }
  stage('create a packages'){
    steps{
      echo 'this will create a package by using the maven'
      sh 'mvn package'
                  }
     }
  stage('publish the html reports'){
    steps{
      publishHTML([allowMissing: false, alwaysLinkToLastBuild: false, keepAll: false, reportDir: '/var/lib/jenkins/workspace/jenkins pipeline/target/surefire-reports', reportFiles: 'index.html', reportName: 'HTML Report', reportTitles: '', useWrapperFileDirectly: true])
                       }
        }
  stage('build the docker image by using package insureme.jar file'){
    steps{
      sh 'docker build -t dineshreddyramala/insureme3:2.0 .'
                      }
   }
   
}
}


